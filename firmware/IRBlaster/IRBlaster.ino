// ---------------------------------------------------------------- helpers
String jsonEscape(const String &s) {
  String o;
  o.reserve(s.length() + 4);
  for (size_t i = 0; i < s.length(); i++) {
    char c = s[i];
    if (c == '"' || c == '\\') { o += '\\'; o += c; }
    else if ((uint8_t)c < 0x20) o += ' ';
    else o += c;
  }
  return o;
}

bool validKey(const String &k) {
  if (k.length() == 0 || k.length() > 20) return false;
  for (size_t i = 0; i < k.length(); i++)
    if (!(isalnum(k[i]) || k[i] == '_')) return false;
  return true;
}

bool safeEquals(const String &a, const String &b) {  // constant-time compare
  if (a.length() != b.length() || a.length() == 0) return false;
  uint8_t d = 0;
  for (size_t i = 0; i < a.length(); i++) d |= a[i] ^ b[i];
  return d == 0;
}

uint8_t rev8(uint8_t x) {
  x = (x & 0xF0) >> 4 | (x & 0x0F) << 4;
  x = (x & 0xCC) >> 2 | (x & 0x33) << 2;
  return (x & 0xAA) >> 1 | (x & 0x55) << 1;
}

const char *modeStr(stdAc::opmode_t m) {
  switch (m) {
    case stdAc::opmode_t::kCool: return "cool";
    case stdAc::opmode_t::kHeat: return "heat";
    case stdAc::opmode_t::kDry:  return "dry";
    case stdAc::opmode_t::kFan:  return "fan";
    default: return "auto";
  }
}
stdAc::opmode_t strMode(const String &s) {
  if (s == "cool") return stdAc::opmode_t::kCool;
  if (s == "heat") return stdAc::opmode_t::kHeat;
  if (s == "dry")  return stdAc::opmode_t::kDry;
  if (s == "fan")  return stdAc::opmode_t::kFan;
  return stdAc::opmode_t::kAuto;
}
const char *fanStr(stdAc::fanspeed_t f) {
  switch (f) {
    case stdAc::fanspeed_t::kMin:
    case stdAc::fanspeed_t::kLow: return "low";
    case stdAc::fanspeed_t::kMedium:
    case stdAc::fanspeed_t::kMediumHigh: return "medium";
    case stdAc::fanspeed_t::kHigh:
    case stdAc::fanspeed_t::kMax: return "high";
    default: return "auto";
  }
}
stdAc::fanspeed_t strFan(const String &s) {
  if (s == "low")    return stdAc::fanspeed_t::kLow;
  if (s == "medium") return stdAc::fanspeed_t::kMedium;
  if (s == "high")   return stdAc::fanspeed_t::kHigh;
  return stdAc::fanspeed_t::kAuto;
}

// ---------------------------------------------------------------- AC state persistence
void saveAc() {
  prefs.putInt("acp", (int)acState.protocol);
  prefs.putShort("acm", acState.model);
  prefs.putBool("pw", acState.power);
  prefs.putChar("md", (int8_t)acState.mode);
  prefs.putFloat("tp", acState.degrees);
  prefs.putChar("fn", (int8_t)acState.fanspeed);
  prefs.putBool("sw", acState.swingv != stdAc::swingv_t::kOff);
}

void loadAc() {
  IRac::initState(&acState);
  acState.protocol = (decode_type_t)prefs.getInt("acp", (int)decode_type_t::UNKNOWN);
  acState.model    = prefs.getShort("acm", -1);
  acState.power    = prefs.getBool("pw", false);
  acState.mode     = (stdAc::opmode_t)prefs.getChar("md", (int8_t)stdAc::opmode_t::kCool);
  acState.degrees  = prefs.getFloat("tp", 24);
  acState.celsius  = true;
  acState.fanspeed = (stdAc::fanspeed_t)prefs.getChar("fn", (int8_t)stdAc::fanspeed_t::kAuto);
  acState.swingv   = prefs.getBool("sw", false) ? stdAc::swingv_t::kAuto : stdAc::swingv_t::kOff;
}

bool acSupported(decode_type_t p) { return IRac::isProtocolSupported(p) || p == decode_type_t::KELON168; }

// Electra / Tadiran / Kelon units sold in Israel use KELON168, which IRac
// doesn't drive. Power on those is a toggle, so we track the last state and
// force "on" with a Super/Turbo frame (turns the unit on), then send the state.
// Start from the frame captured from the customer's own remote (keeps its
// model/fixed bits), clearing one-shot flags; fall back to library defaults.
void kelonBase(IRKelon168Ac &k, bool on) {
  uint8_t tpl[kKelon168StateLength];
  if (prefs.getBytes("k168", tpl, sizeof(tpl)) == sizeof(tpl)) {
    tpl[2] &= ~0x04;               // no power-toggle request
    if (on) tpl[18] |= 0x10; else tpl[18] &= ~0x10;  // "unit is on" flag
    k.setRaw(tpl);
    k.setSuper(false);
    k.setSleep(false);
    k.enableOnTimer(false);
    k.enableOffTimer(false);
  } else {
    k.stateReset();
  }
}

bool sendKelon168() {
  IRKelon168Ac k(txPin);
  k.begin();
  kelonBase(k, acState.power);
  k.setMode(IRKelon168Ac::convertMode(acState.mode));
  k.setFan(IRKelon168Ac::convertFan(acState.fanspeed));
  k.setSwing(acState.swingv != stdAc::swingv_t::kOff);
  k.setTemp((uint8_t)acState.degrees);  // last, so the frame's command is "temperature" (harmless)
  if (!acState.power) {
    if (lastPower) { k.setPower(false); k.send(); }
  } else {
    if (!lastPower) {
      k.setSuper(true);
      k.send();
      delay(400);
      k.setSuper(false);
      k.setMode(IRKelon168Ac::convertMode(acState.mode));
      k.setFan(IRKelon168Ac::convertFan(acState.fanspeed));
      k.setTemp((uint8_t)acState.degrees);
    }
    k.send();
  }
  lastPower = acState.power;
  prefs.putBool("lp", lastPower);
  return true;
}

bool sendAc() {
  if (acState.protocol == decode_type_t::KELON168) return sendKelon168();
  if (!IRac::isProtocolSupported(acState.protocol)) return false;
  bool ok = irac->sendAc(acState, acPrevValid ? &acPrev : nullptr);
  acPrev = acState;
  acPrevValid = true;
  return ok;
}

// ---------------------------------------------------------------- learned code storage
// File layout: header, decoded payload (value or state bytes), raw timings.
struct __attribute__((packed)) CodeHdr {
  uint8_t magic;    // 'I'
  uint8_t kind;     // 0 = value, 1 = state, 2 = raw only
  int16_t type;
  uint16_t bits;
  uint16_t dlen;    // decoded payload bytes
  uint16_t rawlen;  // number of uint16 raw timings
};

bool saveResult(const String &path, const decode_results &r) {
  if (!fsOk) return false;
  CodeHdr h{};
  h.magic = 'I';
  h.type = (int16_t)r.decode_type;
  h.bits = r.bits;
  uint8_t payload[kStateSizeMax];
  if (r.decode_type != decode_type_t::UNKNOWN && hasACState(r.decode_type)) {
    h.kind = 1;
    h.dlen = min((uint16_t)(r.bits / 8), (uint16_t)kStateSizeMax);
    memcpy(payload, r.state, h.dlen);
  } else if (r.decode_type != decode_type_t::UNKNOWN && r.bits <= 64) {
    h.kind = 0;
    h.dlen = 8;
    memcpy(payload, &r.value, 8);
  } else {
    h.kind = 2;
    h.dlen = 0;
  }
  uint16_t *raw = resultToRawArray(&r);
  h.rawlen = getCorrectedRawLength(&r);
  File f = LittleFS.open(path, "w");
  if (!f) { delete[] raw; return false; }
  f.write((uint8_t *)&h, sizeof(h));
  if (h.dlen) f.write(payload, h.dlen);
  f.write((uint8_t *)raw, h.rawlen * 2);
  f.close();
  delete[] raw;
  return true;
}

bool sendCodeFile(const String &path) {
  if (!fsOk) return false;
  File f = LittleFS.open(path, "r");
  if (!f) return false;
  CodeHdr h;
  if (f.read((uint8_t *)&h, sizeof(h)) != sizeof(h) || h.magic != 'I' || h.dlen > kStateSizeMax ||
      h.rawlen > 1024) {
    f.close();
    return false;
  }
  uint8_t payload[kStateSizeMax];
  if (h.dlen) f.read(payload, h.dlen);
  decode_type_t t = (decode_type_t)h.type;
  bool ok = false;
  if (h.kind == 0) {
    uint64_t v;
    memcpy(&v, payload, 8);
    ok = irsend->send(t, v, h.bits, IRsend::minRepeats(t));
  } else if (h.kind == 1) {
    ok = irsend->send(t, payload, h.dlen);
  }
  if (!ok && h.rawlen) {  // protocol can't be re-sent from its decoded form -> replay raw
    uint16_t *raw = new uint16_t[h.rawlen];
    f.read((uint8_t *)raw, h.rawlen * 2);
    irsend->sendRaw(raw, h.rawlen, 38);
    delete[] raw;
    ok = true;
  }
  f.close();
  return ok;
}

// Learned buttons: /c_<id>.bin (code) + /c_<id>.txt ("ac|name" or "tv|name").
void forEachCustom(std::function<void(int, const String &, const String &)> fn) {
  if (!fsOk) return;
  File root = LittleFS.open("/");
  for (File f = root.openNextFile(); f; f = root.openNextFile()) {
    String fn_ = f.name();
    if (fn_.startsWith("/")) fn_ = fn_.substring(1);
    if (!fn_.startsWith("c_") || !fn_.endsWith(".txt")) continue;
    String txt = f.readString(), g = "tv";
    int bar = txt.indexOf('|');
    if (bar == 2 && (txt.startsWith("ac") || txt.startsWith("tv"))) { g = txt.substring(0, 2); txt = txt.substring(3); }
    fn(fn_.substring(2, fn_.length() - 4).toInt(), g, txt);
  }
}

int countCustom() {
  int n = 0;
  if (!fsOk) return 0;
  File root = LittleFS.open("/");
  for (File f = root.openNextFile(); f; f = root.openNextFile()) {
    String fn = f.name();
    if (fn.startsWith("/")) fn = fn.substring(1);
    if (fn.startsWith("c_") && fn.endsWith(".txt")) n++;
  }
  return n;
}

// ---------------------------------------------------------------- TV code sets
int tvKeyIndex(const String &key) {
  for (int i = 0; i < TV_NKEYS; i++)
    if (key == TV_KEYS[i]) return i;
  return -1;
}

uint16_t tvSetMask(int s) {
  uint16_t m = 0;
  for (int k = 0; k < TV_NKEYS; k++)
    if (TV_SETS[s].cmd[k] != 0xFFFF) m |= 1 << k;
  return m;
}

// Encode a key of a code set into IRremoteESP8266 terms (not for P_RCA / P_RAW).
bool tvEncode(int s, int k, decode_type_t &type, uint64_t &value, uint16_t &bits) {
  const TvSet &t = TV_SETS[s];
  uint16_t c = t.cmd[k], a = t.addr;
  if (c == 0xFFFF) return false;
  switch (t.proto) {
    case P_NEC:
      type = decode_type_t::NEC; bits = 32;
      value = (uint32_t)rev8(a) << 24 | (uint32_t)rev8(~a) << 16 | rev8(c) << 8 | rev8(~c);
      return true;
    case P_NECX:
      type = decode_type_t::NEC; bits = 32;
      value = (uint32_t)rev8(a & 0xFF) << 24 | (uint32_t)rev8(a >> 8) << 16 | rev8(c & 0xFF) << 8 | rev8(c >> 8);
      return true;
    case P_SAMSUNG:
      type = decode_type_t::SAMSUNG; bits = 32;
      value = (uint32_t)rev8(a) << 24 | (uint32_t)rev8(a) << 16 | rev8(c) << 8 | rev8(~c);
      return true;
    case P_SIRC12: type = decode_type_t::SONY; bits = 12; value = irsend->encodeSony(12, c, a); return true;
    case P_SIRC15: type = decode_type_t::SONY; bits = 15; value = irsend->encodeSony(15, c, a); return true;
    case P_SIRC20: type = decode_type_t::SONY; bits = 20; value = irsend->encodeSony(20, c, a & 0x1F, a >> 5); return true;
    case P_RC5:
      if (c > 63) { type = decode_type_t::RC5X; bits = kRC5XBits; value = irsend->encodeRC5X(a, c); }
      else { type = decode_type_t::RC5; bits = kRC5Bits; value = irsend->encodeRC5(a, c); }
      return true;
    case P_RC6: type = decode_type_t::RC6; bits = kRC6Mode0Bits; value = irsend->encodeRC6(a, c, kRC6Mode0Bits); return true;
    case P_PANA: type = decode_type_t::PANASONIC; bits = 48; value = irsend->encodePanasonic(0x4004, a >> 8, a & 0xFF, c); return true;
    default: return false;
  }
}

bool sendTvSetKey(int s, int k) {
  if (s < 0 || s >= (int)TV_NSETS || k < 0 || k >= TV_NKEYS) return false;
  const TvSet &t = TV_SETS[s];
  uint16_t c = t.cmd[k];
  if (c == 0xFFFF) return false;
  static bool toggle = false;
  if (t.proto == P_RCA) {  // RCA: 56kHz, 4-bit address + 8-bit command + inverted copy
    uint8_t a = rev8(t.addr) >> 4, cmd = rev8(c);
    uint32_t data = (uint32_t)a << 20 | (uint32_t)cmd << 12 | (uint32_t)(~a & 0xF) << 8 | (uint8_t)~cmd;
    irsend->sendGeneric(4000, 4000, 500, 2000, 500, 1000, 500, 8000, data, 24, 56, true, 1, 33);
    return true;
  }
  if (t.proto == P_RAW) {
    irsend->sendRaw(TV_RAW[c], TV_RAW_LEN[c], 38);
    delay(10);
    irsend->sendRaw(TV_RAW[c], TV_RAW_LEN[c], 38);
    return true;
  }
  decode_type_t type;
  uint64_t v;
  uint16_t bits;
  if (!tvEncode(s, k, type, v, bits)) return false;
  if (type == decode_type_t::RC5 || type == decode_type_t::RC5X) {
    if (toggle) v = irsend->toggleRC5(v);
    toggle = !toggle;
    irsend->sendRC5(v, bits);
    return true;
  }
  if (type == decode_type_t::RC6) {
    if (toggle) v = irsend->toggleRC6(v, bits);
    toggle = !toggle;
    irsend->sendRC6(v, bits);
    return true;
  }
  return irsend->send(type, v, bits, IRsend::minRepeats(type));
}

bool sendTvKey(const String &key) {
  String p = "/t_" + key + ".bin";
  if (fsOk && LittleFS.exists(p)) return sendCodeFile(p);  // learned overrides the code set
  return sendTvSetKey(tvSet, tvKeyIndex(key));
}

// Which code sets would have produced this signal? Returns the first match and
// a list of matching brand names.
int matchTvSet(const decode_results &r, String &brands) {
  int first = -1;
  for (int s = 0; s < (int)TV_NSETS; s++) {
    for (int k = 0; k < TV_NKEYS; k++) {
      decode_type_t type;
      uint64_t v;
      uint16_t bits;
      if (!tvEncode(s, k, type, v, bits)) continue;
      uint64_t mask = type == decode_type_t::RC6 ? 0x10000ULL : (type == decode_type_t::RC5 || type == decode_type_t::RC5X) ? 0x800ULL : 0;
      if (type == r.decode_type && (r.value & ~mask) == (v & ~mask)) {
        if (first < 0) first = s;
        String n = TV_BRAND_NAMES[TV_SETS[s].brand];
        if (brands.indexOf(n) < 0) brands += (brands.length() ? " / " : "") + n;
        break;
      }
    }
  }
  return first;
}

// ---------------------------------------------------------------- learning
void startLearn(LearnMode m, const String &target, const String &name) {
  while (irrecv->decode(&results)) irrecv->resume();  // drain old captures
  learnMode = m;
  learnTarget = target;
  learnName = name;
  learnStatus = "listening";
  learnMsg = "כוון את השלט אל המכשיר ולחץ על הכפתור";
  learnDeadline = millis() + 15000;
}

void finishLearn(const String &status, const String &msg) {
  learnMode = L_IDLE;
  learnStatus = status;
  learnMsg = msg;
}

void handleLearning() {
  if (!irrecv) return;
  if (learnMode == L_IDLE) {
    if (irrecv->decode(&results)) irrecv->resume();  // ignore (e.g. our own transmissions)
    return;
  }
  if ((int32_t)(millis() - learnDeadline) > 0) {
    finishLearn("timeout", "לא נקלט אות. נסה שוב קרוב יותר, או בדוק את פין הקליטה בהגדרות.");
    return;
  }
  if (!irrecv->decode(&results)) return;
  if (results.repeat || (results.decode_type == decode_type_t::UNKNOWN && results.rawlen < 12)) {
    irrecv->resume();
    return;
  }
  String proto = typeToString(results.decode_type);

  switch (learnMode) {
    case L_ACDETECT: {
      decode_type_t t = results.decode_type;
      stdAc::state_t s;
      bool got = false;
      if (t == decode_type_t::KELON168) {
        IRKelon168Ac k(txPin);
        k.setRaw(results.state);
        prefs.putBytes("k168", results.state, kKelon168StateLength);  // template for our own frames
        s = k.toCommon();
        s.protocol = t;
        lastPower = s.power;
        prefs.putBool("lp", lastPower);
        got = true;
      } else if (IRac::isProtocolSupported(t)) {
        got = IRAcUtils::decodeToState(&results, &s);
      }
      if (got) {
        acState = s;
        acState.celsius = true;
        acPrevValid = false;
        saveAc();
        finishLearn("done", "זוהה: " + proto + (s.model > 0 ? " (מודל " + String(s.model) + ")" : "") +
                            ". אפשר לשלוט במזגן מהלשונית מזגן.");
      } else if (t != decode_type_t::UNKNOWN) {
        finishLearn("unsupported", "התקבל " + proto +
                    " – אין לו שליטה מלאה. אפשר ללמוד מצבים קבועים (כיבוי, קירור 24...).");
      } else {
        finishLearn("unsupported", "האות לא זוהה כפרוטוקול מזגן מוכר. אפשר ללמוד מצבים קבועים (כיבוי, קירור 24...).");
      }
      break;
    }
    case L_TVDETECT: {
      String brands;
      int s = matchTvSet(results, brands);
      if (s >= 0) {
        tvSet = s;
        prefs.putInt("tvs", tvSet);
        finishLearn("done", "זוהה: " + brands + ". אפשר לשלוט בטלוויזיה.");
      } else {
        finishLearn("unsupported", "השלט (" + proto + ") לא נמצא במאגר. בחר מותג ובדוק, או למד את הכפתורים מהשלט.");
      }
      break;
    }
    case L_TVKEY: {
      bool ok = saveResult("/t_" + learnTarget + ".bin", results);
      finishLearn(ok ? "done" : "error", ok ? "נלמד (" + proto + ")" : "שגיאת שמירה");
      break;
    }
    case L_CUSTOM: {
      int id = prefs.getInt("cid", 0) + 1;
      bool ok = saveResult("/c_" + String(id) + ".bin", results);
      if (ok) {
        prefs.putInt("cid", id);
        File n = LittleFS.open("/c_" + String(id) + ".txt", "w");
        if (n) { n.print(learnTarget + "|" + learnName); n.close(); }
      }
      finishLearn(ok ? "done" : "error", ok ? "הכפתור '" + learnName + "' נשמר (" + proto + ")" : "שגיאת שמירה");
      break;
    }
    default: break;
  }
  irrecv->resume();
}

// ---------------------------------------------------------------- pin finder
const uint8_t SCAN_PINS[] = {2, 4, 5, 12, 13, 14, 15, 18, 19, 21, 22, 23, 25, 26, 27, 32, 33, 34, 35, 36, 39};

String scanRxPins() {
  uint32_t counts[40] = {0};
  for (uint8_t p : SCAN_PINS)
    if (p != txPin && p != rxPin) pinMode(p, p >= 34 ? INPUT : INPUT_PULLUP);
  delay(5);
  uint32_t prev0 = REG_READ(GPIO_IN_REG), prev1 = REG_READ(GPIO_IN1_REG);
  uint32_t end = millis() + 6000, n = 0;
  while ((int32_t)(millis() - end) < 0) {
    uint32_t c0 = REG_READ(GPIO_IN_REG), c1 = REG_READ(GPIO_IN1_REG);
    uint32_t d0 = c0 ^ prev0, d1 = c1 ^ prev1;
    if (d0 | d1) {
      for (uint8_t p : SCAN_PINS) {
        if (p == txPin) continue;
        if (p < 32 ? (d0 >> p) & 1 : (d1 >> (p - 32)) & 1) counts[p]++;
      }
    }
    prev0 = c0; prev1 = c1;
    if (++n % 20000 == 0) delay(1);
  }
  String o = "[";
  bool first = true;
  for (uint8_t p : SCAN_PINS) {
    if (counts[p] < 10) continue;
    if (!first) o += ",";
    first = false;
    o += "{\"pin\":" + String(p) + ",\"n\":" + String(counts[p]) + "}";
  }
  return o + "]";
}

void testTxPin(int pin) {
  IRsend t(pin);
  t.begin();
  for (int i = 0; i < 8; i++) {  // ~2s of bursts: visible through a phone camera
    t.sendNEC(0x20DF10EF, 32, 3);
    delay(150);
  }
  if (pin != txPin) pinMode(pin, INPUT);
  else irsend->begin();
}

// ---------------------------------------------------------------- JSON
String acJson() {
  String s = "{\"proto\":\"";
  s += acState.protocol == decode_type_t::UNKNOWN ? "" : typeToString(acState.protocol);
  s += "\",\"protoId\":" + String((int)acState.protocol);
  s += ",\"model\":" + String(acState.model);
  s += ",\"supported\":" + String(acSupported(acState.protocol) ? "true" : "false");
  s += ",\"power\":" + String(acState.power ? "true" : "false");
  s += ",\"mode\":\"" + String(modeStr(acState.mode)) + "\"";
  s += ",\"temp\":" + String(acState.degrees, 1);
  s += ",\"fan\":\"" + String(fanStr(acState.fanspeed)) + "\"";
  s += ",\"swing\":" + String(acState.swingv != stdAc::swingv_t::kOff ? "true" : "false");
  return s + "}";
}

String stateJson() {
  String s = "{\"v\":\"" FW_VERSION "\",\"ip\":\"" + WiFi.localIP().toString() + "\"";
  s += ",\"ssid\":\"" + jsonEscape(WiFi.SSID()) + "\",\"rssi\":" + String(WiFi.RSSI());
  s += ",\"portal\":" + String(portalMode ? "true" : "false");
  s += ",\"admin\":" + String(adminPass.length() ? "true" : "false");
  s += ",\"fs\":" + String(fsOk ? "true" : "false");
  s += ",\"tx\":" + String(txPin) + ",\"rx\":" + String(rxPin);
  s += ",\"ac\":" + acJson();
  s += ",\"tv\":{\"set\":" + String(tvSet) + ",\"brands\":[";
  for (int i = 0; i < TV_NBRANDS; i++) s += String(i ? "," : "") + "\"" + TV_BRAND_NAMES[i] + "\"";
  s += "],\"sets\":[";
  for (int i = 0; i < (int)TV_NSETS; i++)
    s += String(i ? "," : "") + "[" + String(TV_SETS[i].brand) + "," + String(tvSetMask(i)) + "]";
  s += "],\"learned\":[";
  String custom = "[";
  if (fsOk) {
    bool f1 = true;
    File root = LittleFS.open("/");
    for (File f = root.openNextFile(); f; f = root.openNextFile()) {
      String n = f.name();
      if (n.startsWith("/")) n = n.substring(1);
      if (n.startsWith("t_") && n.endsWith(".bin")) {
        s += String(f1 ? "" : ",") + "\"" + n.substring(2, n.length() - 4) + "\"";
        f1 = false;
      }
    }
  }
  s += "]}";
  bool f2 = true;
  forEachCustom([&](int id, const String &g, const String &name) {
    custom += String(f2 ? "" : ",") + "{\"id\":" + String(id) + ",\"g\":\"" + g + "\",\"name\":\"" + jsonEscape(name) + "\"}";
    f2 = false;
  });
  s += ",\"custom\":" + custom + "]";
  s += ",\"ios\":\"" + jsonEscape(iosShortcut) + "\"";
  return s + "}";
}

void sendJsonCode(int code, const String &body) {
  server.sendHeader("Cache-Control", "no-store");
  server.send(code, "application/json; charset=utf-8", body);
}
void sendJson(const String &body) { sendJsonCode(200, body); }
void sendErr(const String &msg) { sendJsonCode(400, "{\"ok\":false,\"error\":\"" + jsonEscape(msg) + "\"}"); }

void sendAsset(const char *type, const uint8_t *data, size_t len, bool gz) {
  if (gz) server.sendHeader("Content-Encoding", "gzip");
  server.sendHeader("Cache-Control", gz ? "no-cache" : "max-age=604800");
  server.send_P(200, type, (const char *)data, len);
}

// ---------------------------------------------------------------- security
// 1. Host check: only answer to our own names/IPs (stops DNS-rebinding attacks).
bool hostOk() {
  String h = server.hostHeader();
  h.toLowerCase();
  int c = h.indexOf(':');
  if (c >= 0) h = h.substring(0, c);
  if (h.endsWith(".")) h.remove(h.length() - 1);
  if (h == HOSTNAME ".local" || h == HOSTNAME) return true;
  if (WiFi.status() == WL_CONNECTED && h == WiFi.localIP().toString()) return true;
  if (portalMode && h == WiFi.softAPIP().toString()) return true;
  return false;
}

// 2. Device key on every API call (stops other web pages from sending commands).
bool guardKey() {
  if (!hostOk()) { server.send(403, "text/plain", "forbidden host"); return false; }
  String k = server.hasHeader("X-Key") ? server.header("X-Key") : server.arg("k");
  if (!safeEquals(k, deviceKey)) {
    sendJsonCode(403, "{\"ok\":false,\"error\":\"מפתח שגוי – רענן את הדף\"}");
    return false;
  }
  return true;
}

// 3. Optional admin password (HTTP Basic, user "admin") for risky actions.
bool adminOk() { return adminPass.length() == 0 || server.authenticate("admin", adminPass.c_str()); }
bool guardAdmin() {
  if (!guardKey()) return false;
  if (!adminOk()) { server.requestAuthentication(BASIC_AUTH, "IRBlaster admin"); return false; }
  return true;
}

// ---------------------------------------------------------------- HTTP handlers
void handleAc() {
  if (!guardKey()) return;
  if (server.hasArg("power")) {
    String p = server.arg("power");
    acState.power = p == "toggle" ? !acState.power : (p == "on" || p == "1" || p == "true");
  }
  if (server.hasArg("mode")) acState.mode = strMode(server.arg("mode"));
  if (server.hasArg("temp")) {
    String t = server.arg("temp");
    float v = t == "up" ? acState.degrees + 1 : t == "down" ? acState.degrees - 1 : t.toFloat();
    acState.degrees = constrain(v, 16.0f, 30.0f);
    if (t == "up" || t == "down") acState.power = true;
  }
  if (server.hasArg("fan")) acState.fanspeed = strFan(server.arg("fan"));
  if (server.hasArg("swing")) {
    String s = server.arg("swing");
    acState.swingv = (s == "on" || s == "1" || s == "true") ? stdAc::swingv_t::kAuto : stdAc::swingv_t::kOff;
  }
  saveAc();
  if (!acSupported(acState.protocol)) {
    sendJsonCode(400, "{\"ok\":false,\"error\":\"לא הוגדר מזגן\",\"ac\":" + acJson() + "}");
    return;
  }
  bool ok = sendAc();
  sendJson("{\"ok\":" + String(ok ? "true" : "false") + ",\"ac\":" + acJson() + "}");
}

void handleTv() {
  if (!guardKey()) return;
  String k = server.arg("key");
  if (!validKey(k)) { sendErr("מקש לא תקין"); return; }
  if (sendTvKey(k)) sendJson("{\"ok\":true}");
  else sendErr("אין קוד לכפתור הזה – הגדר טלוויזיה או למד אותו מהשלט");
}

void handleTvTest() {
  if (!guardKey()) return;
  int s = server.arg("set").toInt();
  String k = server.hasArg("key") ? server.arg("key") : "power";
  if (sendTvSetKey(s, tvKeyIndex(k))) sendJson("{\"ok\":true}");
  else sendErr("קוד לא תקין");
}

void handleCustom() {
  if (!guardKey()) return;
  long id = server.arg("id").toInt();
  if (id <= 0) { sendErr("id לא תקין"); return; }
  if (sendCodeFile("/c_" + String(id) + ".bin")) sendJson("{\"ok\":true}");
  else sendErr("כפתור לא נמצא");
}

void handleCustomDelete() {
  if (!guardKey()) return;
  long id = server.arg("id").toInt();
  if (id <= 0 || !fsOk) { sendErr("id לא תקין"); return; }
  LittleFS.remove("/c_" + String(id) + ".bin");
  LittleFS.remove("/c_" + String(id) + ".txt");
  sendJson("{\"ok\":true}");
}

void handleLearn() {
  if (!guardKey()) return;
  String t = server.arg("type");
  if ((t == "tvkey" || t == "custom") && !fsOk) { sendErr("אין מערכת קבצים בלוח – לא ניתן לשמור"); return; }
  if (t == "ac") startLearn(L_ACDETECT, "", "");
  else if (t == "tv") startLearn(L_TVDETECT, "", "");
  else if (t == "tvkey") {
    String k = server.arg("key");
    if (tvKeyIndex(k) < 0) { sendErr("מקש לא תקין"); return; }
    startLearn(L_TVKEY, k, "");
  } else if (t == "custom") {
    String n = server.arg("name");
    n.trim();
    if (n.length() == 0 || n.length() > 40) { sendErr("שם לא תקין"); return; }
    if (countCustom() >= MAX_CUSTOM) { sendErr("הגעת למקסימום כפתורים – מחק כמה"); return; }
    String g = server.arg("g") == "ac" ? "ac" : "tv";
    startLearn(L_CUSTOM, g, n);
  } else { sendErr("סוג לא תקין"); return; }
  sendJson("{\"ok\":true}");
}

void handleSettings() {
  if (!guardKey()) return;
  if (server.hasArg("acproto")) {
    acState.protocol = (decode_type_t)server.arg("acproto").toInt();
    acState.model = server.hasArg("acmodel") ? (int16_t)server.arg("acmodel").toInt() : -1;
    if (server.hasArg("acmodelname"))  // e.g. "YAW1F" from the model search
      acState.model = IRac::strToModel(server.arg("acmodelname").c_str(), -1);
    acPrevValid = false;
    saveAc();
  }
  if (server.hasArg("tvset")) {
    int s = server.arg("tvset").toInt();
    if (s >= -1 && s < (int)TV_NSETS) { tvSet = s; prefs.putInt("tvs", tvSet); }
  }
  sendJson("{\"ok\":true}");
}

void handlePins() {
  if (!guardAdmin()) return;
  bool reboot = false;
  int tx = server.arg("tx").toInt(), rx = server.arg("rx").toInt();
  if (server.hasArg("tx") && tx >= 0 && tx <= 33 && tx != txPin) { prefs.putInt("tx", tx); reboot = true; }
  if (server.hasArg("rx") && rx >= 0 && rx <= 39 && rx != rxPin) { prefs.putInt("rx", rx); reboot = true; }
  sendJson("{\"ok\":true,\"reboot\":" + String(reboot ? "true" : "false") + "}");
  if (reboot) { delay(300); ESP.restart(); }
}

void handleAcProtocols() {
  if (!guardKey()) return;
  String s = "[";
  for (int i = 0; i <= (int)kLastDecodeType; i++) {
    decode_type_t t = (decode_type_t)i;
    if (!acSupported(t)) continue;
    s += String(s.length() > 1 ? "," : "") + "{\"id\":" + String(i) + ",\"name\":\"" + typeToString(t) + "\"}";
  }
  sendJson(s + "]");
}

// ---------------------------------------------------------------- Android "HTTP Shortcuts" export
// Import with: http-shortcuts://import?url=http://<ip>/export/android.json?k=<key>
// All buttons are marked for the Quick Settings tile (tapping it shows a menu).
String hsShortcut(int n, const String &name, const char *icon, const String &url, bool browser) {
  char id[40];
  snprintf(id, sizeof(id), "1b5e0000-0000-4000-8000-%012x", n);
  String s = "{\"id\":\"" + String(id) + "\",\"executionType\":\"" + (browser ? "browser" : "app") + "\"";
  s += ",\"name\":\"" + jsonEscape(name) + "\",\"iconName\":\"" + icon + "\",\"method\":\"GET\"";
  s += ",\"url\":\"" + jsonEscape(url) + "\",\"timeout\":5000,\"quickSettingsTileShortcut\":true";
  s += ",\"responseHandling\":{\"uiType\":\"toast\",\"successOutput\":\"message\",\"successMessage\":\"✓ " + jsonEscape(name) +
       "\",\"failureOutput\":\"simple\"}}";
  return s;
}

void handleAndroidExport() {
  if (!guardKey()) return;
  String b = "http://" + WiFi.localIP().toString(), k = "&k=" + deviceKey;
  struct Item { const char *name; const char *icon; const char *path; };
  static const Item items[] = {
    {"מזגן הפעלה", "bitsies_snow", "/api/ac?power=on"},
    {"מזגן כיבוי", "flat_grey_power", "/api/ac?power=off"},
    {"מזגן טמפ' +", "flat_color_arrow_up", "/api/ac?temp=up"},
    {"מזגן טמפ' −", "flat_color_arrow_down", "/api/ac?temp=down"},
    {"טלוויזיה הפעלה/כיבוי", "flat_color_tv", "/api/tv?key=power"},
    {"ווליום +", "flat_color_volume", "/api/tv?key=vol_up"},
    {"ווליום −", "flat_grey_volume", "/api/tv?key=vol_down"},
    {"השתק", "bitsies_mute", "/api/tv?key=mute"},
    {"ערוץ +", "flat_color_arrow_up2", "/api/tv?key=ch_up"},
    {"ערוץ −", "flat_color_arrow_down2", "/api/tv?key=ch_down"},
  };
  String sc = hsShortcut(1, "פתח שלט מלא", "flat_color_play", b + "/", true);
