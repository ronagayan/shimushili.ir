           "\"name\":\"שלט IR\",\"shortcuts\":[" + sc + "]}]}");
}

// ---------------------------------------------------------------- one universal menu
// Used by the shared iPhone shortcut: GET /api/menu.txt -> pick a line ->
// GET /api/run?n=<line>. Works for every customer without per-device setup.
enum MenuKind : uint8_t { M_AC_ON, M_AC_OFF, M_AC_UP, M_AC_DOWN, M_TV, M_CUSTOM };
struct MenuItem { String label; MenuKind kind; String arg; };

void buildMenu(std::vector<MenuItem> &m) {
  if (acSupported(acState.protocol)) {
    m.push_back({"❄️ מזגן הפעלה", M_AC_ON, ""});
    m.push_back({"❄️ מזגן כיבוי", M_AC_OFF, ""});
    m.push_back({"❄️ מזגן טמפ' +", M_AC_UP, ""});
    m.push_back({"❄️ מזגן טמפ' −", M_AC_DOWN, ""});
  }
  forEachCustom([&](int id, const String &g, const String &name) {
    if (g == "ac") m.push_back({"❄️ " + name, M_CUSTOM, String(id)});
  });
  if (tvSet >= 0 || (fsOk && LittleFS.exists("/t_power.bin"))) {
    static const char *const tv[][2] = {{"📺 טלוויזיה הפעלה/כיבוי", "power"}, {"📺 ווליום +", "vol_up"},
                                        {"📺 ווליום −", "vol_down"}, {"📺 השתק", "mute"},
                                        {"📺 ערוץ +", "ch_up"}, {"📺 ערוץ −", "ch_down"}};
    for (auto &t : tv) m.push_back({t[0], M_TV, t[1]});
  }
  forEachCustom([&](int id, const String &g, const String &name) {
    if (g == "tv") m.push_back({"📺 " + name, M_CUSTOM, String(id)});
  });
}

bool runMenu(const MenuItem &it) {
  switch (it.kind) {
    case M_AC_ON: acState.power = true; break;
    case M_AC_OFF: acState.power = false; break;
    case M_AC_UP: acState.power = true; acState.degrees = min(30.0f, acState.degrees + 1); break;
    case M_AC_DOWN: acState.power = true; acState.degrees = max(16.0f, acState.degrees - 1); break;
    case M_TV: return sendTvKey(it.arg);
    case M_CUSTOM: return sendCodeFile("/c_" + it.arg + ".bin");
  }
  saveAc();
  return sendAc();
}

void handleMenuTxt() {
  if (!guardKey()) return;
  std::vector<MenuItem> m;
  buildMenu(m);
  String out;
  for (auto &it : m) out += (out.length() ? "\n" : "") + it.label;  // no trailing newline (Shortcuts "Split Text")
  server.sendHeader("Cache-Control", "no-store");
  server.send(200, "text/plain; charset=utf-8", out);
}

void handleRun() {
  if (!guardKey()) return;
  String n = server.arg("n");
  n.trim();
  std::vector<MenuItem> m;
  buildMenu(m);
  for (auto &it : m) {
    if (it.label != n) continue;
    bool ok = runMenu(it);
    server.send(ok ? 200 : 500, "text/plain; charset=utf-8", ok ? "✓ " + n : "לא נשלח");
    return;
  }
  server.send(404, "text/plain; charset=utf-8", "לא נמצא");
}

// ---------------------------------------------------------------- firmware update
bool updAllowed = false;

void handleUpdatePage() {
  if (!hostOk()) { server.send(403, "text/plain", "forbidden host"); return; }
  if (portalMode) { server.send(403, "text/plain; charset=utf-8", "עדכון קושחה זמין רק מהרשת הביתית"); return; }
  if (!adminOk()) { server.requestAuthentication(BASIC_AUTH, "IRBlaster admin"); return; }
  sendAsset("text/html; charset=utf-8", UPDATE_HTML, sizeof(UPDATE_HTML), true);
}

void handleUpdateUpload() {
  HTTPUpload &up = server.upload();
  if (up.status == UPLOAD_FILE_START) {
    String k = server.hasHeader("X-Key") ? server.header("X-Key") : server.arg("k");
    updAllowed = !portalMode && hostOk() && safeEquals(k, deviceKey) && adminOk();
    if (updAllowed) Update.begin(UPDATE_SIZE_UNKNOWN);
  } else if (!updAllowed) {
    return;
  } else if (up.status == UPLOAD_FILE_WRITE) {
    Update.write(up.buf, up.currentSize);
  } else if (up.status == UPLOAD_FILE_END) {
    Update.end(true);
  } else if (up.status == UPLOAD_FILE_ABORTED) {
    Update.abort();
  }
}

void handleUpdateDone() {
  if (!updAllowed) {
    if (!adminOk()) { server.requestAuthentication(BASIC_AUTH, "IRBlaster admin"); return; }
    server.send(403, "text/plain; charset=utf-8", "אין הרשאה – רענן את הדף ונסה שוב");
    return;
  }
  bool ok = !Update.hasError() && Update.isFinished();
  server.send(ok ? 200 : 500, "text/plain; charset=utf-8", ok ? "העדכון הצליח, מפעיל מחדש…" : "העדכון נכשל – הקובץ לא תקין");
  updAllowed = false;
  delay(500);
  if (ok) ESP.restart();
}

// ---------------------------------------------------------------- routes
void setupRoutes() {
  static const char *headerKeys[] = {"X-Key", "Authorization"};
  server.collectHeaders(headerKeys, 2);

  server.on("/", HTTP_GET, []() {
    if (portalMode && WiFi.status() != WL_CONNECTED && connState != "ok")
      sendAsset("text/html; charset=utf-8", PORTAL_HTML, sizeof(PORTAL_HTML), true);
    else sendAsset("text/html; charset=utf-8", INDEX_HTML, sizeof(INDEX_HTML), true);
  });
  server.on("/app", HTTP_GET, []() { sendAsset("text/html; charset=utf-8", INDEX_HTML, sizeof(INDEX_HTML), true); });
  server.on("/icon.png", HTTP_GET, []() { sendAsset("image/png", ICON_PNG, sizeof(ICON_PNG), false); });
  server.on("/manifest.json", HTTP_GET, []() {
    server.send(200, "application/manifest+json; charset=utf-8",
                "{\"name\":\"שלט חכם\",\"short_name\":\"שלט\",\"start_url\":\"/\",\"display\":\"standalone\","
                "\"dir\":\"rtl\",\"lang\":\"he\",\"background_color\":\"#0b1220\",\"theme_color\":\"#0b1220\","
                "\"icons\":[{\"src\":\"/icon.png\",\"sizes\":\"192x192\",\"type\":\"image/png\"}]}");
  });

  // Session: hands the device key to our own page. No CORS headers anywhere, so
  // other sites can't read it; the Host check stops DNS rebinding.
  server.on("/api/session", HTTP_GET, []() {
    if (!hostOk()) { server.send(403, "text/plain", "forbidden host"); return; }
    sendJson("{\"k\":\"" + deviceKey + "\"}");
  });

  // Setup portal (only while IR_WIFI is open)
  server.on("/scan", HTTP_GET, []() {
    if (!portalMode) { server.send(404, "text/plain", "not found"); return; }
    int n = WiFi.scanNetworks();
    String s = "[";
    for (int i = 0; i < n; i++) {
      if (WiFi.SSID(i).length() == 0) continue;
      s += String(s.length() > 1 ? "," : "") + "{\"s\":\"" + jsonEscape(WiFi.SSID(i)) + "\",\"r\":" + String(WiFi.RSSI(i)) + "}";
    }
    WiFi.scanDelete();
    sendJson(s + "]");
  });
  server.on("/save", HTTP_POST, []() {
    if (!portalMode) { server.send(404, "text/plain", "not found"); return; }
    String s = server.arg("s"), p = server.arg("p");
    if (s.length() == 0 || s.length() > 32 || p.length() > 64) { sendErr("פרטים לא תקינים"); return; }
    prefs.putString("ssid", s);
    prefs.putString("pass", p);
    sendJson("{\"ok\":true}");
    // connect while keeping IR_WIFI up, so the page can show the new address
    connState = "connecting";
    portalConnecting = true;
    portalConnStart = millis();
    WiFi.disconnect();
    WiFi.begin(s.c_str(), p.c_str());
  });
  server.on("/api/conn", HTTP_GET, []() {
    if (!portalMode) { server.send(404, "text/plain", "not found"); return; }
    sendJson("{\"s\":\"" + connState + "\",\"ip\":\"" +
             (connState == "ok" ? WiFi.localIP().toString() : String("")) + "\"}");
  });
  server.on("/api/finish", HTTP_GET, []() {
    if (!portalMode) { server.send(404, "text/plain", "not found"); return; }
    sendJson("{\"ok\":true}");
    if (connState == "ok") apOffAt = millis() + 1500;
  });

  // Control API (device key required)
  server.on("/api/state", HTTP_GET, []() { if (guardKey()) sendJson(stateJson()); });
  server.on("/api/ac", HTTP_GET, handleAc);
  server.on("/api/tv", HTTP_GET, handleTv);
  server.on("/api/tv/test", HTTP_GET, handleTvTest);
  server.on("/api/custom", HTTP_GET, handleCustom);
  server.on("/api/custom/delete", HTTP_GET, handleCustomDelete);
  server.on("/api/learn", HTTP_GET, handleLearn);
  server.on("/api/learn/status", HTTP_GET, []() {
    if (guardKey()) sendJson("{\"status\":\"" + learnStatus + "\",\"msg\":\"" + jsonEscape(learnMsg) + "\"}");
  });
  server.on("/api/learn/cancel", HTTP_GET, []() {
    if (!guardKey()) return;
    if (learnMode != L_IDLE) finishLearn("idle", "");
    sendJson("{\"ok\":true}");
  });
  server.on("/api/settings", HTTP_GET, handleSettings);
  server.on("/api/acprotocols", HTTP_GET, handleAcProtocols);
  server.on("/export/android.json", HTTP_GET, handleAndroidExport);
  server.on("/api/menu.txt", HTTP_GET, handleMenuTxt);
  server.on("/api/run", HTTP_GET, handleRun);
  server.on("/api/admin/ios", HTTP_GET, []() {
    if (!guardAdmin()) return;
    String u = server.arg("url");
    u.trim();
    if (u.length() && (!u.startsWith("https://www.icloud.com/shortcuts/") || u.length() > 120)) {
      sendErr("צריך קישור iCloud של קיצור (https://www.icloud.com/shortcuts/...)");
      return;
    }
    iosShortcut = u;
    prefs.putString("ios", u);
    sendJson("{\"ok\":true}");
  });

  // Admin API (device key + admin password if set)
  server.on("/api/admin/pins", HTTP_GET, handlePins);
  server.on("/api/admin/test/tx", HTTP_GET, []() {
    if (!guardAdmin()) return;
    int p = server.arg("pin").toInt();
    if (p < 0 || p > 33 || p == 1 || p == 3 || (p >= 6 && p <= 11)) { sendErr("פין לא תקין"); return; }
    testTxPin(p);
    sendJson("{\"ok\":true}");
  });
  server.on("/api/admin/test/rx", HTTP_GET, []() { if (guardAdmin()) sendJson("{\"ok\":true,\"pins\":" + scanRxPins() + "}"); });
  server.on("/api/admin/password", HTTP_POST, []() {
    if (!guardAdmin()) return;
    String p = server.arg("p");
    if (p.length() < 6 || p.length() > 64) { sendErr("הסיסמה צריכה 6–64 תווים"); return; }
    adminPass = p;
    prefs.putString("adm", p);
    sendJson("{\"ok\":true}");
  });
  server.on("/api/admin/wifireset", HTTP_GET, []() {
    if (!guardAdmin()) return;
    sendJson("{\"ok\":true}");
    delay(300);
    prefs.remove("ssid");
    prefs.remove("pass");
    WiFi.disconnect(true, true);  // also erase credentials left by the stock firmware
    delay(300);
    ESP.restart();
  });

  // Firmware update (/update, and /u like the stock firmware)
  server.on("/update", HTTP_GET, handleUpdatePage);
  server.on("/update", HTTP_POST, handleUpdateDone, handleUpdateUpload);
  server.on("/u", HTTP_GET, handleUpdatePage);
  server.on("/u", HTTP_POST, handleUpdateDone, handleUpdateUpload);

  server.onNotFound([]() {
    if (portalMode) {  // captive portal: send phones to the setup page
      server.sendHeader("Location", "http://" + WiFi.softAPIP().toString() + "/", true);
      server.send(302, "text/plain", "");
    } else {
      server.send(404, "text/plain", "not found");
    }
  });
}

// ---------------------------------------------------------------- setup / loop
void startMdns() {
  static bool started = false;
  if (started) return;
  started = MDNS.begin(HOSTNAME);  // http://irblaster.local
  if (started) {
    MDNS.addService("http", "tcp", 80);
    MDNS.addService("irblaster", "tcp", 80);  // lets the phone app find the device without an IP
    MDNS.addServiceTxt("irblaster", "tcp", "v", FW_VERSION);
  }
}

void stopPortal() {
  dns.stop();
  WiFi.softAPdisconnect(true);
  WiFi.mode(WIFI_STA);
  portalMode = false;
  apOffAt = 0;
  Serial.println("Portal closed");
}

void setup() {
  Serial.begin(115200);
  delay(100);
  Serial.println("\nIRBlaster " FW_VERSION);

  prefs.begin("irb", false);
  txPin = prefs.getInt("tx", DEFAULT_TX_PIN);
  rxPin = prefs.getInt("rx", DEFAULT_RX_PIN);
  tvSet = prefs.getInt("tvs", -1);
  if (tvSet >= (int)TV_NSETS) tvSet = -1;
  adminPass = prefs.getString("adm", "");
  lastPower = prefs.getBool("lp", false);
  iosShortcut = prefs.getString("ios", IOS_SHORTCUT_URL);
  deviceKey = prefs.getString("key", "");
  if (deviceKey.length() != 32) {  // first boot: random per-device key
    char buf[33];
    for (int i = 0; i < 4; i++) snprintf(buf + i * 8, 9, "%08lx", (unsigned long)esp_random());
    deviceKey = buf;
    prefs.putString("key", deviceKey);
  }
  loadAc();

  fsOk = LittleFS.begin(true);
  Serial.printf("LittleFS: %s, TX=%d RX=%d\n", fsOk ? "ok" : "FAILED", txPin, rxPin);

  irsend = new IRsend(txPin);
  irsend->begin();
  irac = new IRac(txPin);
  irrecv = new IRrecv(rxPin, 1024, 50, true);
  irrecv->setUnknownThreshold(12);
  irrecv->enableIRIn(true);  // pull-up: a floating RX pin can flood the CPU with interrupts

  // WiFi: saved network -> otherwise credentials left by the stock firmware
  // -> otherwise open the "IR_WIFI" setup portal.
  WiFi.setHostname(HOSTNAME);  // must be set before WiFi.mode() to show up in the router
  WiFi.mode(WIFI_STA);
  String ssid = prefs.getString("ssid", "");
  if (ssid.length()) WiFi.begin(ssid.c_str(), prefs.getString("pass", "").c_str());
  else WiFi.begin();
  uint32_t t0 = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - t0 < 20000) delay(200);

  if (WiFi.status() == WL_CONNECTED) {
    WiFi.setAutoReconnect(true);
    WiFi.setSleep(false);  // modem sleep makes the web UI time out on many (mesh) routers
    Serial.print("IP: ");
    Serial.println(WiFi.localIP());
    startMdns();
  } else {
    Serial.println("WiFi not connected, starting portal " AP_NAME);
    portalMode = true;
    portalUntil = millis() + 300000;  // retry the saved network after 5 minutes
    WiFi.disconnect();
    WiFi.mode(WIFI_AP_STA);
    WiFi.softAP(AP_NAME);
    dns.start(53, "*", WiFi.softAPIP());
  }

  setupRoutes();
  server.begin();
}

void loop() {
  server.handleClient();
  if (portalMode) {
    dns.processNextRequest();
    if (portalConnecting) {
      if (WiFi.status() == WL_CONNECTED) {
        portalConnecting = false;
        connState = "ok";
        WiFi.setAutoReconnect(true);
        WiFi.setSleep(false);
        startMdns();
        apOffAt = millis() + 180000;  // close IR_WIFI after 3 min even if "finish" isn't pressed
        Serial.print("Connected from portal, IP: ");
        Serial.println(WiFi.localIP());
      } else if (millis() - portalConnStart > 20000) {
        portalConnecting = false;
        connState = "fail";
        WiFi.disconnect();
      }
    }
    if (apOffAt && (int32_t)(millis() - apOffAt) > 0) stopPortal();
    else if (!apOffAt && !portalConnecting && connState != "ok" &&
             (int32_t)(millis() - portalUntil) > 0 && WiFi.softAPgetStationNum() == 0) ESP.restart();
  }
  // WiFi watchdog: reconnect if the home network drops, restart if it stays down
  static uint32_t lostSince = 0;
  if (!portalMode) {
    if (WiFi.status() == WL_CONNECTED) lostSince = 0;
    else if (!lostSince) lostSince = millis();
    else if (millis() - lostSince > 180000) ESP.restart();
    else if ((millis() - lostSince) % 30000 < 2) WiFi.reconnect();
  }
  handleLearning();
  delay(1);
}
